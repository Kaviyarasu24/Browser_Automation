# ─────────────────────────────────────────────────────────────────────
# Strawberry — LLM configuration
#
# Uses the OpenAI-compatible Chat Completions API, so any provider that
# speaks that protocol works by changing BASE_URL alone:
#
#   OpenRouter   BASE_URL=https://openrouter.ai/api/v1
#   OpenAI       BASE_URL=https://api.openai.com/v1
#   Groq         BASE_URL=https://api.groq.com/openai/v1
#   Anthropic*   BASE_URL=https://api.anthropic.com/v1
#   local (vLLM) BASE_URL=http://localhost:8000/v1
#
#   * Anthropic's OpenAI-compat layer supports tool calling, but native
#     Anthropic is better. See src/main/agent/llm.ts for that path.
#
# Copy to .env and fill in. .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────

BASE_URL=https://openrouter.ai/api/v1
API_KEY=sk-or-your-key-here

# The agent loop depends on RELIABLE TOOL CALLING. Small/free models often
# emit malformed tool calls and the loop stalls. Recommended, roughly in
# order of reliability for this workload:
#
#   anthropic/claude-sonnet-5-5      best balance, ~$3/Mtok
#   anthropic/claude-opus-5-5        hardest tasks, slower, pricier
#   openai/gpt-5.5                   strong tool caller
#   google/gemini-3-pro              strong, cheaper
#   qwen/qwen3-vl-235b               open weights, decent
#
# Free tiers (e.g. ":free" suffixes) are fine for smoke-testing the UI but
# will usually fail multi-step agent tasks. Start here, then upgrade.
MODEL=anthropic/claude-sonnet-5-5

# Optional. Sent as HTTP-Referer / X-Title to OpenRouter for attribution.
# Harmless on other providers (ignored).
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Strawberry
